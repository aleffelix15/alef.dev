          </div >
        </div >
        <div className="flex items-center gap-3 text-[#E5E5E5]">
          <AnimatePresence>
            {isSearching ? (
              <motion.div
                initial={{ width: 0, opacity: 0 }}
                animate={{ width: 120, opacity: 1 }}
